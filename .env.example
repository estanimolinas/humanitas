# Copiar a .env.local y completar.
# Local: ver README, sección "Levantar el proyecto en local" (la key se lee del contenedor de Storage).
# Producción: se cargan a mano en Vercel (Project Settings → Environment Variables).
# Estas variables se usan SOLO en el servidor. Nunca les pongas el prefijo NEXT_PUBLIC_.

# URL del proyecto Supabase (local: http://127.0.0.1:54321)
SUPABASE_URL=

# Service role key de Supabase. Da acceso total a la base: solo servidor.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp del equipo de Humanitas, para la pantalla de Ayuda (recuperar el acceso, ver los
# datos, darse de baja). Con característica, por ejemplo 342 512 3456. Si queda vacío, la
# pantalla de Ayuda lo avisa en lugar de mostrar el botón.
WHATSAPP_EQUIPO=
